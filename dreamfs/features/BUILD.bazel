# `rust_api_from_cpp` generates `//:dreamfs_rust.hint` with
# `actual = "//features:supported"`, which resolves in this repository rather
# than in `@rules_crubit`. Forward the feature hints so external usage works.

alias(
    name = "supported",
    actual = "@rules_crubit//features:supported",
    visibility = ["//visibility:public"],
)

alias(
    name = "types",
    actual = "@rules_crubit//features:types",
    visibility = ["//visibility:public"],
)
