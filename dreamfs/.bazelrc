# Matches the Crubit Bazel example: C++20, nightly Rust, generic Clang.
build --enable_bzlmod

build:generic_clang --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build:generic_clang --cxxopt=-std=c++20 --host_cxxopt=-std=c++20 --repo_env=BAZEL_CXXOPTS=-std=c++20
build:generic_clang --copt=-Wall --host_copt=-Wall
build:generic_clang --cxxopt=-Wno-range-loop-analysis --host_cxxopt=-Wno-range-loop-analysis
build:generic_clang --copt=-Wno-deprecated --host_copt=-Wno-deprecated
build:generic_clang --copt=-Wno-missing-braces --host_copt=-Wno-missing-braces

build:generic_clang --copt=-fno-rtti --host_copt=-fno-rtti

build --config=generic_clang
build --@rules_rust//rust/toolchain/channel=nightly
build --@rules_rust//rust/settings:experimental_use_allocator_libraries_with_mangled_symbols=true

# std::filesystem requires macOS 10.15; the LLVM toolchain defaults lower.
build --enable_platform_specific_config
build:macos --copt=-mmacosx-version-min=10.15 --linkopt=-mmacosx-version-min=10.15
build:macos --host_copt=-mmacosx-version-min=10.15 --host_linkopt=-mmacosx-version-min=10.15
