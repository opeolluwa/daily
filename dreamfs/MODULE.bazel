module(
    name = "dreamfs",
    version = "0.1.0",
)

bazel_dep(name = "rules_crubit", version = "0.0.1")
git_override(
    module_name = "rules_crubit",
    remote = "https://github.com/google/crubit.git",
    commit = "00604a9f7ea29a273a4e1ba4cfaf82a87c14d951",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "toolchains_llvm", version = "1.11.3")

crubit_toolchains = use_extension("@rules_crubit//bazel:extensions.bzl", "crubit_toolchains")
crubit_toolchains.configure(
    llvm_version = "23.1.3",
    rust_version = "nightly/2026-09-29",
)
use_repo(crubit_toolchains, "llvm_toolchain", "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    "@llvm_toolchain//:all",
)

single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//:patches/rules_rust_transitive_repin.patch"],
    version = "0.74.0",
)
