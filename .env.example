ABLY_API_KEY=

ACCESS_TOKEN_TTL_IN_MINUTES=120

ALLOWED_ORIGINS=*
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

ALMONDS_DB_PATH=almonds-pg

BODY_LIMIT_MB=20
BODY_LIMIT_MB=25

COMPLEXITY_LIMIT=1000

DATABASE_HOST=postgres 
DATABASE_NAME=orchard
DATABASE_PASSWORD=orchard
DATABASE_PORT=5432
DATABASE_URL=postgres://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}
DATABASE_USER=orchard

DEPTH_LIMIT=10

# Account (verification, password reset, OTP, invitations)
EMAIL_FROM_ADDRESS=noreply@almonds.app
EMAIL_FROM_NAME=Almonds
# Kept for older deployments; SMTP_TLS_MODE wins when both are set.
# SMTP_ENCRYPTION=none
EMAIL_PROVIDER=smtp # smtp | mailtrap
# Replies and member support
EMAIL_SUPPORT_FROM_ADDRESS=support@almonds.app
EMAIL_SUPPORT_FROM_NAME="Almonds Support"
# Billing statements and receipts
EMAIL_TRANSACTIONS_FROM_ADDRESS=billing@almonds.app
EMAIL_TRANSACTIONS_FROM_NAME="Almonds Billing"

ENVIRONMENT=development
ENVIRONMENT=development # can be local 

EXPORT_PATH=/tmp/exports

FRONTEND_BASE_URL=http://localhost:500

GRAPHQL_ENDPOINT=/orchard

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=

JWT_SIGNING_KEY=generate-with-openssl-rand-base64-48

LOG_LEVEL=info

MAILTRAP_API_TOKEN=
MAILTRAP_BASE_URL=https://send.api.mailtrap.io/api/send

MAX_DB_CONNECTIONS=10
MAX_DB_CONNECTIONS=10

PORT=8000
PORT=5006

REDIS_CONNECTION_URL=redis://redis:6379

REFRESH_TOKEN_TTL_IN_MINUTES=420

SMTP_AUTH_PASSWORD=
SMTP_AUTH_USERNAME=
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_TLS_MODE=none # none for dev sinks; starttls (default) or implicit in production

UPLOAD_PATH=/tmp/uploads
