  "version": "0.1.0",
  "description": "TypeScript type bindings for the kernel (@daily/core) Rust data-access layer.",
  "type": "module",
  "types": "index.ts",
  "scripts": {
    "generate-types": "node ../scripts/fix-ts-exports.mjs src/entities",
    "build": "npm run generate-types",
